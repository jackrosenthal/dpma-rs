; P4 test configuration: exercises every phone, line, network,
; application, ringtone, alert, firmware, and multicast page option that
; the configuration document uses.
[general]
globalpin=344486
userlist_auth=globalpin
config_auth=mac_globalpin
service_discovery_enabled=no
server_uuid=1b9c3a5e-0000-4000-8000-123456789abc
file_directory=@SLOT@/var/lib/asterisk/digium_phones
registration_address=192.0.2.10
registration_port=5070
firmware_url_prefix=http://192.0.2.10/fw
firmware_package_directory=@SLOT@/var/lib/asterisk/digium_phones/firmware

[network1]
type=network
alias=My Default Network
cidr=10.10.10.0/24
registration_address=10.10.10.10
registration_port=5060
transport=udp
alternate_registration_address=10.10.10.12
alternate_registration_port=5061
alternate_transport=tcp
file_url_prefix=http://10.10.10.10/digium_phones_files
public_firmware_url_prefix=http://10.10.10.10/public
ntp_server=0.digium.pool.ntp.org
syslog_server=10.1.2.3
syslog_port=514
syslog_level=error
network_vlan_discovery_mode=MANUAL
sip_qos=3
rtp_qos=5
pc_qos=2
network_vlan_id=4
pc_vlan_id=6
sip_dscp=24
rtp_dscp=46
udp_ka_interval=60

[network2]
type=network
alias=Remote & <Other>
cidr=0.0.0.0/0
registration_address=pbx.example.com
registration_port=5061
transport=tls
file_url_prefix=https://files.example.com/dp
syslog_server=10.9.9.9
network_vlan_discovery_mode=LLDP
network_vlan_id=0

[network3]
type=network
alias=VLAN no qos
cidr=172.16.0.0/12
registration_address=172.16.0.1
registration_port=5060
syslog_level=debug
network_vlan_discovery_mode=MANUAL
network_vlan_id=7
network_vlan_qos=4

[fancytone]
type=ringtone
alias=FancyTone
filename=FancyTone.wav

[plaintone]
type=ringtone
filename=/abs/Plain.wav

[urltone]
type=ringtone
alias=URL Tone
filename=http://elsewhere/tone.wav

[notone]
type=ringtone
alias=No file

[firmware-D40_1_1]
type=firmware
model=d40
version=1_1_0_0_48178
file=1_1_0_0_48178_D40_firmware.eff
public_firmware=yes

[firmware-D65]
type=firmware
model=D65
version=2_9_17
file=http://fw.example.com/2_9_17_D65_firmware.eff

[firmware-noversion]
type=firmware
model=D80
file=x.eff
public_firmware=yes

[alert-fancytone]
type=alert
alert_info=ai-FancyTone
ring_type=ring-answer
ringtone=fancytone

[alert-default-type]
type=alert
alert_info=ai-plain
ringtone=Chimes

[alert-noinfo]
type=alert
ring_type=visual
ringtone=Chimes

[everyone2]
type=multicastpage
alias=AllPage
address=237.0.0.101
port=32000
priority=5
interrupt=1

[noalias]
type=multicastpage
address=237.0.0.102
port=32002
priority=2

[fullphone]
type=phone
network=network1
network=network2
network=nosuchnet
network=network3
mac=01:23:45:67:89:ab
pin=1234&<5>
group_pin=777
firmware=firmware-D40_1_1
firmware=nosuchfw
firmware=firmware-D65
firmware=firmware-noversion
line=full101
line=nosuchline
external_line=ext1234
line=full102
application=queue-app
application=status-app
application=parking-app
application=vm-app
application=custom-app
application=custom-nofile
application=nosuchapp
full_name=Full "Phone" & Co
contact=contacts-local.xml
contact=contacts-remote.xml
contact=/abs/contacts.xml
contact=http://example.com/c.xml
contacts_display_rules=rules.xml
blf_contact_group=RapidDial
blf_items=blf.xml
timezone=America/Los_Angeles
ntp_resync=86400
parking_exten=700
parking_transfer_type=blind
ringtone=fancytone
ringtone=GuitarStrum
ringtone=plaintone
ringtone=urltone
ringtone=notone
ringtone=nosuchtone
alert=alert-fancytone
alert=alert-default-type
alert=alert-noinfo
alert=nosuchalert
multicastpage=everyone2
multicastpage=noalias
multicastpage=nosuchpage
codecs=PCMU,!PCMA,G722,G7221,G726-32,opus,!G729,iLBC,L16,L16-256
d40_logo_file=d40_logo.png
d65_logo_file=d65_logo.png
wallpaper_file=wall.png
active_locale=de_DE
login_password=9876
accept_local_calls=host
name_format=last_first
lan_port_mode=1000
pc_port_mode=auto
ehs=jabra
web_ui_enabled=yes
record_own_calls=yes
blf_unused_linekeys=yes
blf_page_return_timeout=15
send_to_vm=yes
use_local_storage=yes
contacts_max_subscriptions=40
lock_preferences=yes
brightness=5
contrast=7
dim_backlight=yes
backlight_timeout=30
backlight_dim_level=2
default_fontsize=12
handshake_timeout=3600
display_mc_notification=no
idle_company_text=ACME <Corp>
small_clock=yes
allow_insecure_ssl=yes
ringer_volume=4
speaker_volume=3
handset_volume=2
headset_volume=1
handset_sidetone_db=-10
headset_sidetone_db=-5
reset_call_volume=yes
headset_answer=yes
ring_headset_only=yes
call_waiting_tone=no
can_forward_calls=yes
show_call_log=yes
show_call_parking=yes
logout_enabled=yes
expansion_enabled=yes
expansion_page_indicators_enabled=yes
enable_check_sync=yes
transport_tls_allowed=yes
8021x_passthrough=1
8021x_method=EAP-TLS
8021x_eapol_on_disconnect=1
8021x_identity=me
8021x_anonymous_identity=anon
8021x_password=secret
8021x_client_cert_url=http://x/certs/client.pem
8021x_root_cert_url=http://x/certs/root.pem
8021x_root_cert_value=explicit-root
8021x_debug=1
openvpn_enable=yes
openvpn_config_file_url=http://x/vpn/client.conf
openvpn_root_cert_url=noslash
openvpn_client_cert_url=http://x/vpn/c.crt
openvpn_client_cert_value=cval
openvpn_client_key_url=http://x/vpn/c.key
openvpn_logging=verbose

