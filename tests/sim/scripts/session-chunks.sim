# Session layer (package P7): multi-chunk messages in both directions.
# Needs a devtest build (dpmadev session event) and the setup of
# session.sim.  EVENT_CHUNKS is the number of chunks of a 2000-byte event:
# 5 over UDP (0x1a4 bytes of plaintext per chunk), 3 over TCP (0x384):
#
#   EVENT_CHUNKS=5 DPMA_SLOT=<n> dev/sim/dpma_sim.py script dev/sim/scripts/session-chunks.sim
#   EVENT_CHUNKS=3 DPMA_SLOT=<n> dev/sim/dpma_sim.py --transport tcp script dev/sim/scripts/session-chunks.sim

set L=abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij

handshake
expect type=HandshakeResponse

# Phone to server, encrypted: one base64 text split over many MESSAGEs
# (the server joins the chunk bodies and decodes once).
raw PingRequest --body "${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}" --chunk-size 100
expect type=PingResponse error=none encrypted=yes
raw PingRequest --body "${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}" --chunk-size 7
expect type=PingResponse error=none encrypted=yes

# Phone to server, plaintext: Echo in ten chunks, one reply with the whole
# body.
echo "${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}" --chunk-size 100
expect type=EchoResponse error=0 encrypted=no chunks=1 body="${L}${L}${L}${L}${L}${L}${L}${L}${L}${L}"

# Server to phone, encrypted: an event of 2000 bytes, every chunk with the
# "Command: " prefix inside the encryption, each chunk's ciphertext base64
# encoded on its own.
cli dpmadev session event ${session} digium.config.update 2000
listen --count 1 --seconds 5
expect event=digium.config.update encrypted=yes chunks=${env.EVENT_CHUNKS} payload~^<config>0123 payload~</config>$ problems=none
expect header:Message-Salt? header:Session=${session} header:ID!

# digium.assignment.update goes out as the original sends it: no event
# name, ID bootcReset, Error-ID -398, and the Session Timeout error body
# after the event body.
cli dpmadev session event ${session} digium.assignment.update hello
listen --count 1 --seconds 5
expect error=-398 header:ID=bootcReset event! encrypted=yes payload~^hello<error

# Server to phone, plaintext: the HandshakeResponse (AppServer certificate)
# in several chunks with sequence numbers.
handshake
expect type=HandshakeResponse chunks~^[23]$ header:Message-Sequence=0
