# Session layer (package P7): idle sessions are pruned (prune_inactive in
# FUN_0014f280): unauthenticated ones idle more than 119 s, authenticated
# but inactive ones idle more than 59 s; authenticated active sessions are
# kept.  Pruning runs at the start of a read cycle, so each check backdates
# the session (dpmadev session idle, which also lets the next cycle prune
# at once), completes a transaction (an Echo) to start a new cycle, then
# pings.  Needs a devtest build and the setup of session.sim.
#
#   DPMA_SLOT=<n> tests/sim/dpma_sim.py script tests/sim/scripts/session-prune.sim

# Unauthenticated: kept at 118 s, pruned at 121 s.
handshake
cli dpmadev session idle ${session} 118
echo cycle
ping
expect type=PingResponse error=none
cli dpmadev session idle ${session} 121
echo cycle
raw PingRequest --encrypt no
expect type=HandshakeResponse error=-398

# Authenticated and active: never pruned.
handshake
cli dpmadev session mark ${session} authenticated
cli dpmadev session idle ${session} 100000
echo cycle
ping
expect type=PingResponse error=none

# Authenticated but inactive: kept at 58 s, pruned at 61 s.
cli dpmadev session mark ${session} inactive
cli dpmadev session idle ${session} 58
echo cycle
ping
expect type=PingResponse error=none
cli dpmadev session idle ${session} 61
echo cycle
raw PingRequest --encrypt no
expect type=HandshakeResponse error=-398

# The phone handshakes again.
handshake
ping
expect type=PingResponse
