# Simulator smoke test that needs no module: the loopback dialplan of
# conf/extensions_dpma_sim.conf answers Echo from 127.0.0.2.
#   DPMA_SLOT=5 dev/sim/dpma_sim.py --local-host 127.0.0.2 --no-digium-ua-header script dev/sim/scripts/loopback.sim
# (--no-digium-ua-header: with the PJSIP helper loaded, a request carrying
# X-Digium-User-Agent goes to the module instead of the loopback context.)

echo "hello loopback"
expect type=EchoResponse error=0 body="hello loopback" encrypted=no chunks=1 status=202
capture first_id id
print sent id ${first_id}

# A multi-chunk plaintext request: the loopback answers each chunk, the
# first answer completes the exchange.
echo "0123456789abcdefghijklmnopqrstuvwxyz" --chunk-size 10 --header "X-Test: chunked"
expect type=EchoResponse body~^0123

# Every chunk reaches the dialplan with its sequence headers.
cli dialplan show proxy@dpma-sim-loopback
expect-ami Output~MessageSend

# A request type the loopback ignores: accepted by SIP, no reply.
try raw PingRequest --session 1 --encrypt no --timeout 1
expect reply=none status=202

# AMI round trip.
ami Ping
expect-ami Response=Success Ping=Pong
